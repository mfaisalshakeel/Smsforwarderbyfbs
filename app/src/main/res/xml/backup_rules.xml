<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup is disabled application-wide (android:allowBackup="false") because this app
  stores SMS bodies, OTP codes and mail credentials. These rules stay as a second
  line of defence in case backup is ever re-enabled.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="sms_forwarder_settings.xml" />
    <exclude domain="sharedpref" path="sms_forwarder_secure.xml" />
    <exclude domain="database" path="sms_forwarder_database" />
    <exclude domain="database" path="sms_forwarder_database-shm" />
    <exclude domain="database" path="sms_forwarder_database-wal" />
</full-backup-content>
